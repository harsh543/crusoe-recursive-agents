# Copy to .env.local and fill in. Keys may contain $, so no shell export is needed here.
CRUSOE_API_KEY=

# You.com Web Search, Contents, Research, and Finance Research
# Keep the real value in .env.youcom or a process environment variable.
YDC_API_KEY=

# Supabase (backend only; the service role key must never reach the UI). Without these, src/casefile/store.py
# writes to data/store/*.jsonl and `python -m casefile.store --replay` uploads later.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
